# Backend & Base de Datos
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/metatrain_vr
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=28800
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api

# Azure Speech (opcional en desarrollo; obligatorio para narración y micrófono)
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com
AZURE_SPEECH_TTS_ENDPOINT=https://your-region.tts.speech.microsoft.com
AZURE_SPEECH_KEY=replace-with-azure-speech-key
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_FEMALE_VOICE=es-EC-AndreaNeural
AZURE_SPEECH_MALE_VOICE=es-EC-LuisNeural
